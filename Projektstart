#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo
printf '%s\n' "Herzlich willkommen bei Pawsitters - ein Projekt von Raphael Buller, Niklas Ulbrich & Justus Krahl"
echo
printf '%s\n' "Frontend gestartet & erreichbar unter: http://127.0.0.1:4173"

cd "$SCRIPT_DIR/frontend"
npm i >/dev/null 2>&1
npm run dev >/dev/null 2>&1
